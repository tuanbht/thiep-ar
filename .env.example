# Copy to .env.local and fill in. Server-only values never reach the browser.

# The site's public address: gift links and QR codes point here. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4: the web stream's measurement ID (G-…). Empty: no analytics. In GA, turn off Enhanced measurement >
# Page views > "Page changes based on browser history events" (the app sends its own page views, private links cut out).
NEXT_PUBLIC_GA_ID=

# Supabase (server only). Local: `pnpm db:start` prints them; cloud: Project settings > API.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SECRET_KEY=
# Only for the database tests (pnpm test runs them when it is set)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# Payments: "test" pays at once (development only), "sepay" for VietQR bank transfers through SePay.
PAYMENT_PROVIDER=test
# Allow the test provider in production too (a demo site). Never on a real shop.
ALLOW_TEST_PAYMENTS=false

# SePay: the API token (my.sepay.vn > Cấu hình công ty > API Access) and its API (production; sandbox tokens use
# https://userapi-sandbox.sepay.vn/v2). The bank account is read from SePay; set its id only when several are linked.
SEPAY_API_KEY=
SEPAY_API_URL=https://userapi.sepay.vn/v2
SEPAY_BANK_ACCOUNT_ID=
# The webhook (SePay > Webhooks, URL https://<site>/callbacks/sepay/ipn): its HMAC-SHA256 secret, or its API key.
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_API_KEY=

# The nightly cleanup of abandoned orders and photos (GET /api/cron/cleanup, Vercel Cron sends it): 32+ random chars.
CRON_SECRET=
# A header only your host sets with the caller's address, for the rate limits (Vercel: x-vercel-forwarded-for).
TRUSTED_IP_HEADER=
