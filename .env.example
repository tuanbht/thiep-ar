# Copy to .env.local and fill in. Server-only values never reach the browser.

# The site's public address: gift links and QR codes point here. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server only). Local: `pnpm db:start` prints them; cloud: Project settings > API.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SECRET_KEY=
# Only for the database tests (pnpm test runs them when it is set)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# Payments: "test" pays at once (development only), "zalopay" once its keys are in.
PAYMENT_PROVIDER=test
# Allow the test provider in production too (a demo site). Never on a real shop.
ALLOW_TEST_PAYMENTS=false

# The nightly cleanup of abandoned orders and photos (GET /api/cron/cleanup, Vercel Cron sends it): 32+ random chars.
CRON_SECRET=
# A header only your host sets with the caller's address, for the rate limits (Vercel: x-vercel-forwarded-for).
TRUSTED_IP_HEADER=

# ZaloPay (later): app id, key1 (signs requests), key2 (checks callbacks), endpoint
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/
